{
  "$comment": "示范信源：首次启动时导入（scripts/seed.ts），已存在的不会被覆盖。之后在后台“信源”里新建、修改和暂停。字段说明见 docs/customize.md。天合富家排在最前：它是这个站最优先追踪的信源。",
  "sources": [
    {
      "id": "trinapower-news",
      "name": "天合富家",
      "kind": "json_list",
      "config": {
        "url": "https://www.trinapower.com/trina-power-api/newsApi/newsSearch",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json"
        },
        "bodyJson": {
          "page": 1,
          "limit": 1000
        },
        "itemsPath": "data",
        "titlePaths": [
          "newsTitle"
        ],
        "summaryPaths": [
          "newsIntro"
        ],
        "summaryIsBody": true,
        "publishedAtPath": "newsDate",
        "externalIdPath": "newsId",
        "urlTemplate": "https://www.trinapower.com/news/detail?id={newsId}",
        "sortByPublishedAt": true,
        "_aihot": {
          "initialBackfillLimit": 12
        }
      },
      "tier": "T1",
      "owner_entity_id": "tianhe-fujia",
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": [
        "官方",
        "分布式"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
